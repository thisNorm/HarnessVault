{
  "name": "harnessvault",
  "version": "0.0.0",
  "private": true,
  "description": "HarnessVault — Company Harness Runtime",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "npm run dev -w @harnessvault/api",
    "dev:web": "npm run dev -w @harnessvault/web",
    "db:generate": "npm run db:generate -w @harnessvault/api",
    "db:migrate": "npm run db:migrate -w @harnessvault/api",
    "test:e2e": "node scripts/with-api.mjs npm run test:e2e -w @harnessvault/api",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "scan:secrets": "node scripts/scan-secrets.mjs --all",
    "db:seed": "npm run db:seed -w @harnessvault/api",
    "setup:resources": "npm run setup:resources -w @harnessvault/api",
    "test:web": "node scripts/with-api.mjs npm run test:web -w @harnessvault/web",
    "verify": "npm run ci && npm run test:e2e && npm run test:web",
    "demo:approval": "node scripts/with-api.mjs node apps/api/test/scenario-approval-routing.mjs",
    "demo:setup": "node scripts/with-api.mjs node apps/api/test/demo-accounts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
