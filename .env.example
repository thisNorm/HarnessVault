# 애플리케이션
NODE_ENV=development
PORT=3000

# 데이터베이스
# 아래 3개는 docker-compose.yml이 컨테이너를 만들 때 쓰고, DATABASE_URL은 앱이 접속할 때 쓴다.
# 로컬 개발 기본값이다. 공용 환경에 띄운다면 반드시 바꾼다.
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harnessvault
DATABASE_URL=postgresql://harness:harness@localhost:5432/harnessvault

# 세션 유효 기간 (시간)
SESSION_TTL_HOURS=720

# 웹 콘솔 origin (쉼표 구분)
WEB_ORIGINS=http://localhost:3100
