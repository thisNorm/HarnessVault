# 애플리케이션
NODE_ENV=development
PORT=3000

# 데이터베이스
# 아래 3개는 docker-compose.yml이 컨테이너를 만들 때 쓰고, DATABASE_URL은 앱이 접속할 때 쓴다.
# 로컬 개발 기본값이다. 공용 환경에 띄운다면 반드시 바꾼다.
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harnessvault
DATABASE_URL=postgresql://harness:harness@localhost:5432/harnessvault

# 세션 유효 기간 (시간)
SESSION_TTL_HOURS=720

# 웹 콘솔 origin (쉼표 구분)
WEB_ORIGINS=http://localhost:3100

# Resource Gateway credential (Phase 6, 옵션 C)
# resources.credential_ref가 가리키는 환경변수. 이름은 HARNESS_RESOURCE_ 로 시작해야 한다.
HARNESS_RESOURCE_DEMO_DB=postgresql://harness:harness@localhost:5432/demo_app

# 임베딩 — 선택. 없으면 중복 탐색이 어휘 기반(LEXICAL)으로 동작한다.
# 설정하면 pgvector 의미 검색(VECTOR)이 된다. 768차원 모델만 쓸 수 있다.
# EMBEDDING_URL=http://localhost:11434/api/embed
# EMBEDDING_MODEL=nomic-embed-text

# Curator — 선택. 없으면 배선 검증용 대역(MOCK)이 돌고 결과에 그 사실이 박힌다.
# 로컬 모델은 느리므로 타임아웃이 넉넉하다.
# CURATOR_URL=http://localhost:11434/api/chat
# CURATOR_MODEL=qwen3.6:latest

# 로그인 시도 제한 — 계정 존재 여부를 흘리지 않도록 제출된 이메일로 센다.
LOGIN_MAX_ATTEMPTS=10
# 한 IP가 창 안에 실패시킬 수 있는 서로 다른 계정 수. 실패 횟수가 아니다.
LOGIN_MAX_ACCOUNTS_PER_IP=20
# 스프레이로 표시된 IP에서도 (IP, 계정)마다 비밀번호 확인을 거쳐 주는 횟수.
# 이게 없으면 오타 한 번 낸 사람이 맞는 비밀번호로도 막힌다.
LOGIN_VERIFY_GRACE_PER_PAIR=3
# X-Forwarded-For를 믿을지. 프록시 뒤에 있을 때만 true로 둔다 — 위조 가능한 헤더다.
TRUST_PROXY=false
LOGIN_LOCKOUT_MINUTES=15

# 만료 세션 정리 주기(분). 0이면 끈다.
SESSION_PURGE_INTERVAL_MINUTES=60

# 쿠키 — 운영에서 웹과 API 도메인이 갈리면 none + secure가 필요하다.
# none인데 secure가 아니면 브라우저가 쿠키를 조용히 버리므로 부팅을 막는다.
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.example.com
